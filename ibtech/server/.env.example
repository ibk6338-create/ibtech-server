# Copy this file to .env and fill in your real values.
# Never commit the real .env file — .env should be in your .gitignore.

# Server port
PORT=3000

# From your Paystack Dashboard -> Settings -> API Keys & Webhooks
# Leave blank to run the server with wallet-funding/payout routes disabled
# (everything else — signup, login, printing, stock, refunds, access
# control — still works without this).
PAYSTACK_SECRET_KEY=

# From your Resend Dashboard -> API Keys (resend.com/api-keys)
# Leave blank to run with password-reset emails disabled — the reset code
# is returned directly in the API response instead (fine for local dev,
# not for a live server).
RESEND_API_KEY=

# Must be on a domain you've verified in Resend, e.g.
# "IB-TECH <noreply@yourdomain.com>". Defaults to Resend's shared test
# sender, which only delivers to your own Resend account email.
RESEND_FROM_EMAIL=
